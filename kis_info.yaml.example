# 한국투자증권(KIS) Open API 인증 정보
# 이 파일을 복사해서 kis_info.yaml 로 저장하고 실제 값을 채워 넣으세요.
# kis_info.yaml 은 .gitignore 에 등록되어 있어 git에 커밋되지 않습니다.

# https://apiportal.koreainvestment.com 에서 발급받은 값
app_key: "YOUR_APP_KEY"
app_secret: "YOUR_APP_SECRET"

# 계좌번호 앞 8자리
cano: "YOUR_ACCOUNT_FRONT_8"
# 계좌번호 뒤 2자리 (상품코드, 보통 위탁계좌는 01)
acnt_prdt_cd: "01"

# 실전투자 도메인 사용 (모의투자로 바꾸려면 false)
is_real: true
